// Cloudflare Workflows scheduler. Cloudflare parses these crons and invokes the scheduled
// handler once per match, handing it the expression that fired -- so there is no cron
// matcher in this repo.
//
// Cron triggers, not the Workflow binding's own `schedules`: those are a paid-plan feature,
// and `wrangler deploy` refuses them on the free plan. The ceiling here is 5 cron
// expressions per Cloudflare account, against 100 for the paid-only kind.
//
// triggers.crons is generated: `task crons` writes it from schedules/, which is where the
// expressions are actually decided. This file is JSON and cannot import them, so they are
// copied here; test/schedules.test.ts fails until the copy matches. Do not edit it by hand.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dispatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Nothing here is meant to be reachable over HTTP. The fetch handler exists because
  // wrangler requires a default export, and this keeps it off a public URL entirely.
  "workers_dev": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 5 * * *"] },
  "workflows": [
    {
      "name": "dispatch",
      "binding": "DISPATCH",
      "class_name": "Dispatch"
    }
  ]
}
